---
export enum Device {
  MOBILE = "MOBILE",
  DESKTOP = "DESKTOP",
}

export enum Target {
  BLANK = "_blank",
  SELF = "_self",
  PARENT = "_parent",
  TOP = "_top",
}

export type Props = {
  href: string;
  text: string;
  device: Device;
  target?: Target;
  extraClasses?: string;
};
const { href, text, device, target, extraClasses } = Astro.props;

const desktopClasses =
  "relative text-md font-semibold text-dark-gray after:absolute after:bottom-[-2px] after:left-0 after:h-0.5 after:w-0 after:bg-primary after:transition-all after:duration-300 hover:after:w-full hover:text-primary";

const mobileClasses =
  "hover:text-primary-light border-primary-light -mx-3 block rounded-lg px-3 py-2 text-base/7 font-semibold text-dark-gray hover:bg-white";
---

<a
  href={href}
  class:list={[
    device === Device.DESKTOP ? desktopClasses : mobileClasses,
    extraClasses,
  ]}
  target={target}>{text}</a
>
